# Copy to .env before "docker compose up". Both images bind 0.0.0.0, so the
# compose files refuse to start until these are set.

# Bearer token for the management API. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MEMNOX_ADMIN_TOKEN=

# Encrypts agents, approvals, decisions, policy history and the audit log.
# Prefer a keyring: it is salted and can be rotated without downtime.
#   memnox keys generate --keyring-file memnox-keyring.json
#   memnox keys rewrap        # after adding a new key
MEMNOX_KEYRING_FILE=memnox-keyring.json

# "permissive" reads pre-encryption records and counts them; switch to "strict"
# once memnox_plaintext_records_read_total sits at zero.
MEMNOX_ENCRYPTION_MODE=permissive

# Legacy single key — unsalted and cannot rotate. Kept so older deployments
# keep reading their own records; prefer MEMNOX_KEYRING_FILE above.
# MEMNOX_DATA_KEY=

# Shared Postgres storage. Required when running more than one instance;
# without it each instance keeps its own local files.
# MEMNOX_DATABASE_URL=postgres://memnox:memnox@postgres:5432/memnox
