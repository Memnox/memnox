#!/bin/sh
# We ship a secret scanner. Running it on our own staged changes is the least we
# can do — CI re-runs it on the PR diff, so this is convenience, not the gate.
set -e

if [ ! -f packages/cli/dist/index.js ]; then
  echo "memnox: CLI not built, skipping the staged secret scan (run 'npm run build')"
  exit 0
fi

node packages/cli/dist/index.js ci --staged
