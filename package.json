{
  "name": "memnox-runtime-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Memnox — the execution trust layer for AI agents. Deterministic identity, policy, approval, and audit for every AI action.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @memnox/core -w @memnox/policy-engine -w @memnox/code-graph -w @memnox/content-shield -w @memnox/intelligence -w @memnox/local-gate -w @memnox/sdk -w @memnox/mcp-firewall -w @memnox/memory -w @memnox/postgres -w @memnox/redis -w @memnox/risk -w @memnox/runtime -w @memnox/trust-bench -w memnox",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "deadcode": "knip",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^5.46.0",
    "prettier": "^3.3.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
