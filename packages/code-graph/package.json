    "import-graph",
    "blast-radius",
    "static-analysis"
  ],
  "license": "Apache-2.0",
  "author": "Memnox",
  "homepage": "https://github.com/Memnox/memnox/tree/main/packages/code-graph#readme",
  "repository": {
