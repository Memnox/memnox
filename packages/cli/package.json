{
  "name": "memnox",
  "version": "0.13.15",
  "description": "Your agents can already do the work. Memnox makes it safe to let them do it without you: one boundary of allow, ask and deny over every agent on your machine.",
  "keywords": [
    "ai-agents",
    "governance",
    "cli",
    "policy",
    "audit"
  ],
  "license": "Apache-2.0",
  "author": "Memnox",
  "homepage": "https://github.com/Memnox/memnox/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Memnox/memnox.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Memnox/memnox/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "memnox": "dist/index.js",
    "memnox-mcp-proxy": "dist/bin/mcp-proxy.js",
    "memnox-shell": "dist/bin/shell.js",
    "memnox-intercept": "dist/bin/intercept.js",
    "memnox-git-credential": "dist/bin/git-credential.js",
    "memnox-egress": "dist/bin/egress.js",
    "memnox-edit-hook": "dist/bin/edit-hook.js",
    "memnox-session": "dist/bin/session.js",
    "memnox-operator": "dist/bin/operator.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@memnox/core": "workspace:*",
    "@memnox/interceptors": "workspace:*",
    "@memnox/proxy": "workspace:*",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.4.2",
    "yaml": "^2.4.0"
  },
  "optionalDependencies": {
    "@memnox/noise": "workspace:*"
  },
  "devDependencies": {
    "@memnox/vscode": "workspace:*"
  }
