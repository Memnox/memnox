{
  "name": "@memnox/local-gate",
  "version": "0.2.0",
  "description": "In-process policy gate — matches a call's own arguments and scans its content on the machine that makes it, so the raw payload never crosses the network.",
  "keywords": [
    "policy",
    "authorization",
    "ai-agents",
    "security",
    "local"
  ],
  "license": "Apache-2.0",
  "author": "Memnox",
  "homepage": "https://github.com/Memnox/memnox/tree/main/packages/local-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Memnox/memnox.git",
    "directory": "packages/local-gate"
  },
  "bugs": {
    "url": "https://github.com/Memnox/memnox/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@memnox/core": "0.2.0",
    "@memnox/policy-engine": "0.2.0",
    "yaml": "^2.4.0"
  }
}
