# Memnox plus Graphify in one image.
#
# The npm package cannot carry a Python one, so a local install keeps Graphify
# optional. A container can carry both, which is the only place "all in one" is
# honest — no host prerequisites, nothing for the operator to reconcile.
#
# Debian rather than Alpine on purpose: tree-sitter wheels are built for glibc,
# and on musl every grammar compiles from source.
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package*.json tsconfig*.json ./
COPY packages ./packages
RUN npm ci && npm run build

FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

# uv installs Graphify into its own environment, so nothing lands in the system
# site-packages this image also has to keep working.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

ENV UV_INSTALL_DIR=/usr/local/bin
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Pinned: the adapter is written against this schema and a test asserts it.
ARG GRAPHIFY_VERSION=0.8.36
# Out of /root, which is 0700 — the unprivileged runtime user has to reach it.
ENV UV_TOOL_DIR=/opt/uv/tools
ENV UV_TOOL_BIN_DIR=/usr/local/bin
RUN uv tool install "graphifyy==${GRAPHIFY_VERSION}" \
  && chmod -R a+rX /opt/uv \
  && graphify --version

COPY --from=build /app/package*.json ./
COPY --from=build /app/packages ./packages
RUN npm ci --omit=dev && npm cache clean --force

# Both licences travel with the binaries they cover — Apache-2.0 section 4.
COPY LICENSE ./LICENSE
COPY docker/THIRD-PARTY-NOTICES.md ./THIRD-PARTY-NOTICES.md

# Runs unprivileged; the only writable path is the data volume.
RUN groupadd -r memnox && useradd -r -g memnox memnox && mkdir -p /data \
  && chown -R memnox:memnox /data
USER memnox
COPY --chown=memnox:memnox --chmod=0755 docker/entrypoint-allinone.sh /usr/local/bin/entrypoint.sh
VOLUME /data
EXPOSE 7466
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
